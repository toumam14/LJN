---
interface Props {
  soundwave?: string;
}
const { soundwave } = Astro.props;
---

<aside
  class="sidebar"
  style={soundwave ? `--soundwave-url: url('${soundwave}')` : ""}
>
  <nav class="sidebar-nav" id="sidebarNav"></nav>
</aside>

<style lang="scss">
  @use "../styles/variables" as *;

  .sidebar {
    flex-shrink: 0;
    position: sticky;
    top: var(--spacing-xl);
    padding-left: var(--spacing-page-desktop);
    margin-block: var(--spacing-section);
    margin-inline: var(--spacing-2xl) 0;
    background-image: var(--soundwave-url);
    height: 100vh;
    width: 400px;
    background-repeat: no-repeat;
    background-size: cover;

    @media (max-width: $breakpoint-3xl) {
      width: 200px;
    }

    @media (max-width: $breakpoint-md) {
      display: none;
    }
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    position: sticky;
    top: 120px;
    margin-block: var(--spacing-section);
  }
  
</style>

<style is:global>
  .sidebar-entry {
    scroll-margin-top: 120px;
  }

  .sidebar-link {
    font-family: "Roboto Mono", monospace;
    font-size: var(--font-title-subheading);
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-black);
    display: block;
  }

  .sidebar-link:hover {
    opacity: 0.6;
  }
</style>

<script>
  const entries = document.querySelectorAll(".sidebar-entry");
  const nav = document.getElementById("sidebarNav");

  if (nav) {
    entries.forEach((entry) => {
      if (!entry.id) return;
      const link = document.createElement("a");
      link.href = `#${entry.id}`;
      link.className = "sidebar-link";
      link.textContent = (entry.textContent ?? "").trim();
      nav.appendChild(link);
    });
  }
</script>
