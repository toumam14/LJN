---
interface Props {
  title?: string;
  body?: string;
  variant?: 'fixed' | 'flexible';
}

const { title, body, variant = 'fixed' } = Astro.props;
const hasSlot = Astro.slots.has('default');
---

<div class:list={['content-callout', `content-callout--${variant}`]}>
  <div class="content-callout-text">
    {title && <h4 class="small-title">{title}</h4>}
    {hasSlot
      ? <div class="content-callout-body"><slot /></div>
      : body && <p class="body-text">{body}</p>
    }
  </div>
</div>

<style lang="scss">
  @use "../styles/variables" as *;

  .content-callout {
    background-color: var(--light-color);
    display: flex;
    flex-wrap: wrap;
    flex-shrink: 0;
    overflow: hidden;
    gap: var(--spacing-lg);
    border-radius: var(--border-radius-xl);
    padding: var(--spacing-lg);
    margin-block: var(--spacing-md);
  }

  .content-callout--fixed {
    width: 260px;
    min-height: 275px;
  }

  .content-callout--flexible {
    flex: 1 1 320px;
    min-width: 0;
  }

  .content-callout-text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    width: 100%;

    .small-title,
    .body-text {
      margin: 0;
    }
  }

  .content-callout-body {
    display: flex;
    flex-direction: column;

    :global(p) {
      font-family: "Work Sans", system-ui, sans-serif;
      font-size: var(--font-body-main);
      font-weight: 400;
      margin: 0;
    }

    :global(p strong),
    :global(strong) {
      font-weight: 700;
    }

    :global(.callout-strong) {
      margin-top: var(--spacing-md);
    }

    :global(ul) {
      list-style: disc;
      padding-left: var(--spacing-lg);
      margin: var(--spacing-xs) 0 0 0;
      display: flex;
      flex-direction: column;
    }

    :global(li) {
      font-family: "Work Sans", system-ui, sans-serif;
      font-size: var(--font-body-main);
      font-weight: 400;
      line-height: var(--line-height-body);
    }
  }

  @media (max-width: $breakpoint-md) {
    .content-callout {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
