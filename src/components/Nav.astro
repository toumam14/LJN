---
import iconLogo from '../assets/icon-logo.svg';
import Button from './Button.astro';
const iconLogoUrl = iconLogo.src;

const donateHref = 'https://www.zeffy.com/en-AU/donation-form/donate-to-change-lives-16969';

interface Props {
  logo?: string;
}

const { logo } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const isExactActive = (href: string) => pathname === href || pathname === `${href}/`;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  {
    href: '/services',
    label: 'Services',
    children: [
      { href: '/services/interpreting-and-translation', label: 'Interpreting & Translation' },
      { href: '/services/training-consulting-development', label: 'Training, Consulting & Policy' },
      { href: '/services/launchpad-program', label: 'Launchpad Program' },
    ],
  },
  // { href: '/resources', label: 'Resources' },
  { href: '/get-involved', label: 'Get Involved' },
];
---

<header class="nav">

  <!-- Desktop -->
  <div class="nav-desktop">
    <a href="/" class="nav-logo-link">
      {logo && <img src={logo} alt="Language Justice Network" class="nav-logo" />}
    </a>
    <div class="nav-right">
      <nav aria-label="Main navigation">
        <ul class="nav-links">
          {navLinks.map(link => (
            <li class:list={['nav-item', { 'nav-item--has-dropdown': link.children }]}>
              <a
                href={link.href}
                class:list={['nav-link', { 'nav-link--active': isActive(link.href) }]}
                aria-haspopup={link.children ? 'true' : undefined}
              >
                {link.label}
              </a>
              {link.children && (
                <ul class="nav-dropdown" role="menu">
                  {link.children.map(child => (
                    <li role="none">
                      <a
                        href={child.href}
                        role="menuitem"
                        class:list={['nav-dropdown-link', { 'nav-dropdown-link--active': isExactActive(child.href) }]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <Button href={donateHref} label="Donate" variant="primary" external />
    </div>
  </div>

  <!-- Mobile bar -->
  <div class="nav-mobile">
    <a href="/" class="nav-logo-link">
      <img src={iconLogoUrl} alt="Language Justice Network" class="nav-icon" />
    </a>
    <button class="nav-menu-btn" id="navMenuBtn" aria-expanded="false" aria-controls="navOverlay">
      Menu
    </button>
  </div>

  <!-- Mobile overlay -->
  <div class="nav-overlay" id="navOverlay" aria-hidden="true">
    <div class="nav-overlay-top">
      <a href="/" class="nav-logo-link">
        {logo
          ? <img src={logo} alt="Language Justice Network" class="nav-logo" />
          : <img src={iconLogoUrl} alt="Language Justice Network" class="nav-icon" />
        }
      </a>
      <button class="nav-close-btn" id="navCloseBtn">Close</button>
    </div>
    <nav aria-label="Mobile navigation">
      <ul class="nav-overlay-links">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-overlay-link', { 'nav-overlay-link--active': isActive(link.href) }]}
            >
              {link.label}
            </a>
            {link.children && (
              <ul class="nav-overlay-sublinks">
                {link.children.map(child => (
                  <li>
                    <a
                      href={child.href}
                      class:list={['nav-overlay-sublink', { 'nav-overlay-sublink--active': isExactActive(child.href) }]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>

</header>

<style lang="scss">
  @use "../styles/variables" as *;

  .nav {
    background-color: var(--nav-bg);
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-logo-link {
    display: flex;
    align-items: center;
    padding: var(--spacing-lg) 0;

    @media (max-width: $breakpoint-lg) {
      padding: unset;
    }
  }

  .nav-logo {
    height: 60px;
    width: auto;
    display: block;
  }

  .nav-icon {
    height: 70px;
    width: auto;
    display: block;
  }

  // ---- Desktop ----

  .nav-desktop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--spacing-3xl);

    @media (max-width: $breakpoint-lg) {
      display: none;
    }
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--spacing-2xl);
  }

  .nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;

    li + li {
      margin-left: var(--spacing-2xl);
    }
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    font-family: "Roboto Mono", monospace;
    font-size: var(--font-body-button);
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    color: white;
    padding: var(--spacing-lg) 0;
    display: block;

    &--active {
      font-weight: 600;
      border-bottom: 1px solid white;
    }

    &:hover:not(&--active) {
      opacity: 0.75;
    }
  }

  // ---- Desktop dropdown ----

  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 260px;
    list-style: none;
    margin: 0;
    padding: var(--spacing-sm) 0;
    background-color: var(--nav-bg);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.15s ease-in-out, transform 0.15s ease-in-out, visibility 0.15s;
    z-index: 110;

    li + li {
      margin-left: 0;
    }
  }

  .nav-item--has-dropdown:hover .nav-dropdown,
  .nav-item--has-dropdown:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown-link {
    font-family: "Roboto Mono", monospace;
    font-size: var(--font-body-button);
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    color: white;
    display: block;
    padding: var(--spacing-sm) var(--spacing-lg);

    &--active {
      font-weight: 600;
    }

    &:hover:not(&--active) {
      opacity: 0.75;
    }
  }

  // ---- Mobile bar ----

  .nav-mobile {
    display: none;
    align-items: center;
    justify-content: space-between;
    padding:  var(--spacing-sm) var(--spacing-xl);

    @media (max-width: $breakpoint-lg) {
      display: flex;
      padding-block: 0;
    }
  }

  .nav-menu-btn,
  .nav-close-btn {
    font-family: "Roboto Mono", monospace;
    font-size: var(--font-body-button);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--button-text);
    background-color: var(--button-bg);
    border: none;
    cursor: pointer;
    padding: var(--spacing-sm) var(--spacing-lg);
    border-radius: var(--border-radius-xl);
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s ease-in-out;

    &:hover {
      opacity: 0.85;
    }
  }

  // ---- Mobile overlay ----

  .nav-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background-color: var(--nav-bg);
    z-index: 200;
    flex-direction: column;

    &.is-open {
      display: flex;
    }
  }

  .nav-overlay-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-xl);
  }

  .nav-overlay-links {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0 var(--spacing-xl);
  }

  .nav-overlay-link {
    font-family: "Roboto Mono", monospace;
    font-size: var(--font-title-heading);
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    color: white;
    display: block;
    padding-bottom: var(--spacing-lg);

    &--active {
      font-weight: 600;
    }

    &:hover:not(&--active) {
      opacity: 0.75;
    }

    li:last-child & {
      padding-bottom: 0;
    }
  }

  .nav-overlay-sublinks {
    list-style: none;
    margin: 0 0 var(--spacing-lg) 0;
    padding: 0 0 0 var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .nav-overlay-sublink {
    font-family: "Roboto Mono", monospace;
    font-size: var(--font-title-subheading);
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    color: white;
    display: block;

    &--active {
      font-weight: 600;
    }

    &:hover:not(&--active) {
      opacity: 0.75;
    }
  }
</style>

<script>
  const menuBtn = document.getElementById('navMenuBtn');
  const closeBtn = document.getElementById('navCloseBtn');
  const overlay = document.getElementById('navOverlay');

  menuBtn?.addEventListener('click', () => {
    overlay?.classList.add('is-open');
    menuBtn.setAttribute('aria-expanded', 'true');
    overlay?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  });

  closeBtn?.addEventListener('click', () => {
    overlay?.classList.remove('is-open');
    menuBtn?.setAttribute('aria-expanded', 'false');
    overlay?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  });
</script>
