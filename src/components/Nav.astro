---
import iconLogo from '../assets/icon-logo.svg';
const iconLogoUrl = iconLogo.src;

interface Props {
  logo?: string;
}

const { logo } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);

const navLinks = [
  { href: '/', label: 'Home'},
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/resources', label: 'Resources' },
  { href: '/get-involved', label: 'Get Involved' },
];
---

<header class="nav">

  <!-- Desktop -->
  <div class="nav-desktop">
    <a href="/" class="nav-logo-link">
      {logo && <img src={logo} alt="Language Justice Network" class="nav-logo" />}
    </a>
    <nav aria-label="Main navigation">
      <ul class="nav-links">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { 'nav-link--active': isActive(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Mobile bar -->
  <div class="nav-mobile">
    <a href="/" class="nav-logo-link">
      <img src={iconLogoUrl} alt="Language Justice Network" class="nav-icon" />
    </a>
    <button class="nav-menu-btn" id="navMenuBtn" aria-expanded="false" aria-controls="navOverlay">
      Menu
    </button>
  </div>

  <!-- Mobile overlay -->
  <div class="nav-overlay" id="navOverlay" aria-hidden="true">
    <div class="nav-overlay-top">
      <a href="/" class="nav-logo-link">
        {logo
          ? <img src={logo} alt="Language Justice Network" class="nav-logo" />
          : <img src={iconLogoUrl} alt="Language Justice Network" class="nav-icon" />
        }
      </a>
      <button class="nav-close-btn" id="navCloseBtn">Close</button>
    </div>
    <nav aria-label="Mobile navigation">
      <ul class="nav-overlay-links">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-overlay-link', { 'nav-overlay-link--active': isActive(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

</header>

<style lang="scss">
  @use "../styles/variables" as *;

  .nav {
    background-color: var(--nav-bg);
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-logo-link {
    display: flex;
    align-items: center;
    padding: var(--spacing-lg) 0;

    @media (max-width: $breakpoint-lg) {
      padding: unset;
    }
  }

  .nav-logo {
    height: 60px;
    width: auto;
    display: block;
  }

  .nav-icon {
    height: 70px;
    width: auto;
    display: block;
  }

  // ---- Desktop ----

  .nav-desktop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--spacing-3xl);

    @media (max-width: $breakpoint-lg) {
      display: none;
    }
  }

  .nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;

    li + li {
      margin-left: var(--spacing-2xl);
    }
  }

  .nav-link {
    font-family: "Roboto Mono", monospace;
    font-size: var(--font-body-button);
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    color: white;
    padding: var(--spacing-lg) 0;
    display: block;

    &--active {
      font-weight: 600;
      border-bottom: 1px solid white;
    }

    &:hover:not(&--active) {
      opacity: 0.75;
    }
  }

  // ---- Mobile bar ----

  .nav-mobile {
    display: none;
    align-items: center;
    justify-content: space-between;
    padding:  var(--spacing-sm) var(--spacing-xl);

    @media (max-width: $breakpoint-lg) {
      display: flex;
      padding-block: 0;
    }
  }

  .nav-menu-btn,
  .nav-close-btn {
    font-family: "Roboto Mono", monospace;
    font-size: var(--font-body-button);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--button-text);
    background-color: var(--button-bg);
    border: none;
    cursor: pointer;
    padding: var(--spacing-sm) var(--spacing-lg);
    border-radius: var(--border-radius-xl);
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s ease-in-out;

    &:hover {
      opacity: 0.85;
    }
  }

  // ---- Mobile overlay ----

  .nav-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background-color: var(--nav-bg);
    z-index: 200;
    flex-direction: column;

    &.is-open {
      display: flex;
    }
  }

  .nav-overlay-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-xl);
  }

  .nav-overlay-links {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0 var(--spacing-xl);
  }

  .nav-overlay-link {
    font-family: "Roboto Mono", monospace;
    font-size: var(--font-title-heading);
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    color: white;
    display: block;
    padding-bottom: var(--spacing-lg);

    &--active {
      font-weight: 600;
    }

    &:hover:not(&--active) {
      opacity: 0.75;
    }

    li:last-child & {
      padding-bottom: 0;
    }
  }
</style>

<script>
  const menuBtn = document.getElementById('navMenuBtn');
  const closeBtn = document.getElementById('navCloseBtn');
  const overlay = document.getElementById('navOverlay');

  menuBtn?.addEventListener('click', () => {
    overlay?.classList.add('is-open');
    menuBtn.setAttribute('aria-expanded', 'true');
    overlay?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  });

  closeBtn?.addEventListener('click', () => {
    overlay?.classList.remove('is-open');
    menuBtn?.setAttribute('aria-expanded', 'false');
    overlay?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  });
</script>
