<style is:global lang="scss">
  @use "../styles/variables" as *;

  article,
  aside,
  details,
  figcaption,
  figure,
  footer,
  header,
  hgroup,
  nav,
  section,
  summary {
    display: block;
  }
  audio,
  canvas,
  video {
    display: inline-block;
  }
  audio:not([controls]) {
    display: none;
    height: 0;
  }
  [hidden] {
    display: none;
  }
  html {
    font-family: sans-serif;
    -webkit-text-size-adjust: 100%;
    -ms-text-size-adjust: 100%;
  }
  a:focus {
    outline: thin dotted;
  }
  a:active,
  a:hover {
    outline: 0;
  }
  h1 {
    font-size: 2em;
  }
  abbr[title] {
    border-bottom: 1px dotted;
  }
  b,
  strong {
    font-weight: 700;
  }
  dfn {
    font-style: italic;
  }
  mark {
    background: #ff0;
    color: #000;
  }
  code,
  kbd,
  pre,
  samp {
    font-family: monospace, serif;
    font-size: 1em;
  }
  pre {
    white-space: pre-wrap;
    word-wrap: break-word;
  }
  q {
    quotes: \201C \201D \2018 \2019;
  }
  small {
    font-size: 80%;
  }
  sub,
  sup {
    font-size: 75%;
    line-height: 0;
    position: relative;
    vertical-align: baseline;
  }
  sup {
    top: -0.5em;
  }
  sub {
    bottom: -0.25em;
  }
  img {
    border: 0;
  }
  svg:not(:root) {
    overflow: hidden;
  }
  fieldset {
    border: 1px solid silver;
    margin: 0 2px;
    padding: 0.35em 0.625em 0.75em;
  }
  button,
  input,
  select,
  textarea {
    font-family: inherit;
    font-size: 100%;
    margin: 0;
  }
  button,
  input {
    line-height: normal;
  }
  button,html input[type=button],/* 1 */input[type=reset],input[type=submit] {
    -webkit-appearance: button;
    cursor: pointer;
  }
  button[disabled],
  input[disabled] {
    cursor: default;
  }
  input[type="checkbox"],
  input[type="radio"] {
    box-sizing: border-box;
    padding: 0;
  }
  input[type="search"] {
    -webkit-appearance: textfield;
    -moz-box-sizing: content-box;
    -webkit-box-sizing: content-box;
    box-sizing: content-box;
  }
  input[type="search"]::-webkit-search-cancel-button,
  input[type="search"]::-webkit-search-decoration {
    -webkit-appearance: none;
  }
  textarea {
    overflow: auto;
    vertical-align: top;
  }
  table {
    border-collapse: collapse;
    border-spacing: 0;
  }
  body,
  figure {
    margin: 0;
  }
  legend,
  button::-moz-focus-inner,
  input::-moz-focus-inner {
    border: 0;
    padding: 0;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .clearfix:after {
    visibility: hidden;
    display: block;
    font-size: 0;
    content: "";
    clear: both;
    height: 0;
  }

  * {
    -moz-box-sizing: border-box;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
  }

  .visuallyHidden:not(:focus):not(:active) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    border: 0;
    padding: 0;
    white-space: nowrap;
    clip-path: inset(100%);
    clip: rect(00 0 0);
    overflow: hidden;
  }

  /* Global CSS variables */
  :root {
    // Heading fonts
    --font-title-big-heading: 60px;
    --font-title-heading: 32px;
    --font-title-subheading: 14px;

    // Body fonts
    --font-body-intro: 24px;
    --font-body-intro-mobile: 21px;
    --font-body-main: 18px;
    --font-body-button: 14px;

    --color-white: #ffffff;
    --color-black: #000000;

    // Theme colors

    // Brown theme
    --brown-theme-primary: #361a11;
    --brown-theme-secondary: #f29009;
    --brown-theme-tertiary: #e5e64b;
    --brown-theme-light: #fbdeb5;
    --brown-theme-pale: #fef4e6;

    // Red theme
    --red-theme-primary: #740026;
    --red-theme-secondary: #eb5a5d;
    --red-theme-tertiary: #fcb5b2;
    --red-theme-light: #ffc0cb;
    --red-theme-pale: #fdeeef;

    // Purple theme
    --purple-theme-primary: #3d206d;
    --purple-theme-secondary: #6b57a5;
    --purple-theme-tertiary: #b4aaee;
    --purple-theme-light: #e9e5fa;
    --purple-theme-pale: #e9e6f3;

    // Blue theme
    --blue-theme-primary: #01123e;
    --blue-theme-secondary: #2e75b3;
    --blue-theme-tertiary: #91d3eb;
    --blue-theme-light: #def2f9;
    --blue-theme-pale: #f4fbfd;

    // Green theme
    --green-theme-primary: #022b23;
    --green-theme-secondary: #47a62c;
    --green-theme-tertiary: #afe680;
    --green-theme-light: #c8e4c0;
    --green-theme-pale: #edf6ea;

    // Border radius
    --border-radius-sm: 4px;
    --border-radius-md: 8px;
    --border-radius-lg: 12px;
    --border-radius-xl: 20px;

    // Max widths
    --max-width-page: 900px;
    --max-width-content: 800px;

    // Spacing — page layout (horizontal)
    --spacing-page-desktop: 30px;
    --spacing-page-mobile: 16px;

    // Spacing — section vertical rhythm
    --spacing-section: 50px;
    --spacing-section-inner: 30px;
    --spacing-block: 10px;

    // Spacing — component scale
    --spacing-xs: 5px;
    --spacing-sm: 10px;
    --spacing-md: 15px;
    --spacing-lg: 20px;
    --spacing-xl: 30px;
    --spacing-2xl: 40px;
    --spacing-3xl: 50px;

    // Line heights
    --line-height-tight: 1.2;
    --line-height-body: 1.6;
  }

  .page-outer {
    display: flex;
    align-items: flex-start;
  }

  .page-layout {
    flex: 1;
    min-width: 0;
    max-width: var(--max-width-page);
    padding-inline: var(--spacing-page-desktop);
    margin: var(--spacing-2xl) auto;

    @media (max-width: $breakpoint-sm) {
      padding-inline: var(--spacing-page-mobile);
    }
  }

  // Theme classes — applied to <body> per page
  .theme-brown {
    --button-bg: var(--brown-theme-secondary);
    --button-text: var(--brown-theme-primary);
    --nav-bg: var(--brown-theme-primary);
    --page-bg: var(--brown-theme-pale);
    --heading-color: var(--brown-theme-secondary);
    --primary-color: var(--brown-theme-primary);
    --tertiary-color: var(--brown-theme-tertiary);
    --light-color: var(--brown-theme-light);
  }

  .theme-blue {
    --button-bg: var(--blue-theme-tertiary);
    --button-text: var(--blue-theme-primary);
    --nav-bg: var(--blue-theme-primary);
    --page-bg: var(--blue-theme-pale);
    --heading-color: var(--blue-theme-secondary);
    --primary-color: var(--blue-theme-primary);
    --tertiary-color: var(--blue-theme-tertiary);
    --light-color: var(--blue-theme-light);
  }

  .theme-green {
    --button-bg: var(--green-theme-tertiary);
    --button-text: var(--green-theme-primary);
    --nav-bg: var(--green-theme-primary);
    --page-bg: var(--green-theme-pale);
    --heading-color: var(--green-theme-secondary);
    --primary-color: var(--green-theme-primary);
    --tertiary-color: var(--green-theme-tertiary);
    --light-color: var(--green-theme-light);
  }

  .theme-purple {
    --button-bg: var(--purple-theme-tertiary);
    --button-text: var(--purple-theme-primary);
    --nav-bg: var(--purple-theme-primary);
    --page-bg: var(--purple-theme-pale);
    --heading-color: var(--purple-theme-secondary);
    --primary-color: var(--purple-theme-primary);
    --tertiary-color: var(--purple-theme-tertiary);
    --light-color: var(--purple-theme-light);

    hr {
      border-color: var(--tertiary-color);
    }
  }

  .theme-red {
    --button-bg: var(--red-theme-secondary);
    --button-text: var(--color-black);
    --nav-bg: var(--red-theme-primary);
    --page-bg: var(--red-theme-pale);
    --heading-color: var(--red-theme-secondary);
    --primary-color: var(--red-theme-primary);
    --tertiary-color: var(--red-theme-tertiary);
    --light-color: var(--red-theme-light);
  }

  body {
    background-color: var(--page-bg);
    overflow-x: hidden;
  }

  // ---- Typography utility classes ----

  .eyebrow-text {
    font-family: "Roboto Mono", monospace;
    font-size: var(--font-title-subheading);
    font-weight: 400;
    text-transform: uppercase;
    // margin-top: 0;
  }

  .heading-text {
    font-family: "Work Sans", system-ui, sans-serif;
    font-size: var(--font-title-heading);
    font-weight: 700;
    color: var(--heading-color);
    margin-block: 0;
  }

  hr {
    border: 2px solid var(--light-color);
    width: 85%;
    margin-block: var(--spacing-section);
  }

  .intro-text {
    font-family: "Work Sans", system-ui, sans-serif;
    font-size: var(--font-body-intro);
    font-weight: 700;

    @media (max-width: $breakpoint-md) {
      font-size: var(--font-body-intro-mobile);
    }
  }

  .body-text {
    font-family: "Work Sans", system-ui, sans-serif;
    font-size: var(--font-body-main);
    font-weight: 400;
  }

  .small-title {
    font-family: "Roboto Mono", monospace;
    font-size: var(--font-title-subheading);
    font-weight: 400;
    text-transform: uppercase;
    border-bottom: 1px solid var(--heading-color);
  }

  .content-section {
    margin-block: var(--spacing-section);
    display: flex;
    flex-direction: column;
  }

  .content-callouts {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
    gap: var(--spacing-lg);
  }

  .button-wrapper {
    margin-top: var(--spacing-xl);
    align-self: center;
  }

  .list-layout {
    list-style: disc;
    padding-left: var(--spacing-xl);
  }

  
</style>
