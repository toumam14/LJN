---
import { Image } from "astro:assets";
// import heroImage from "../assets/hero-image-compressed.jpg";
// import Nav from "../components/Nav.astro";
import BaseComponent from "../layouts/BaseComponent.astro";
import Button from "../components/Button.astro";
import ContactCallout from "../components/ContactCallout.astro";
---

<style lang="scss">
  @use "../styles/variables" as *;

  // ---------- HERO ----------

  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-3xl);

    @media (max-width: $breakpoint-xl) {
      flex-direction: column;
      text-align: center;

      .hero-image,
      .button {
        align-self: center;
      }
    }
  }

  .hero-content {
    flex: 1.2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;

    @media (max-width: $breakpoint-sm) {
      p {
        font-size: var(--font-body-md);
      }
    }
  }

  .hero-image {
    position: relative;

    img {
      display: block;
      max-width: 420px;
      width: 100%;
    }
  }

  // ---------- SECTION WRAPPERS ----------

  .our-mission,
  .community-impact,
  .get-involved {
    border-radius: var(--border-radius-lg);
    border: 1px solid var(--secondary-color);
    background: var(--tertiary-color);
    padding: 24px 22px;
  }

  // ---------- OUR MISSION -----------

  .our-mission {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    @media (max-width: $breakpoint-sm) {
      align-items: center;
    }
  }

  // ---------- WHAT WE DO ----------

  .what-we-do {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    align-items: flex-start;

    .info-box-wrapper {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--gap-lg);
      margin: 0 auto;
    }

    .info-box {
      background-color: var(--tertiary-color);
      border-radius: var(--border-radius-lg);
      border: 1px solid var(--secondary-color);
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
    }

    @media (max-width: $breakpoint-xl) {
      .button {
        align-self: center;
      }
    }

    @media (max-width: $breakpoint-lg) {
      .info-box-wrapper {
        grid-template-columns: repeat(1, 1fr);
      }
    }

    @media (max-width: $breakpoint-xs) {
      .info-box {
        width: 280px;
        height: 240px;
      }
    }
  }
  // ---------- COMMUNITY IMPACT ----------

  .community-impact {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--gap-xl);
    align-items: flex-start;

    .button {
      text-align: center;
    }

    @media (max-width: $breakpoint-xl) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .impact-supporting-wrapper {
    display: flex;
    flex-direction: column;

    blockquote {
      margin: 0;
      padding: 14px 16px;
      border-left: 4px solid var(--primary-color);
      background: var(--page-background);
      border-radius: var(--border-radius-md);
      font-size: var(--font-body-sm);
      line-height: 1.5;
    }

    cite {
      font-style: normal;
      font-weight: 600;
    }
  }

  // ---------- WHY LANGUAGE JUSTICE MATTERS ----------

  .matters {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    @media (max-width: $breakpoint-sm) {
      align-items: center;
    }

    em {
      font-weight: 500;
    }
  }

  // ---------- GET INVOLVED ----------

  .get-involved {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--gap-md);
    }

    @media (max-width: $breakpoint-sm) {
      .actions a {
        width: 100%;
        text-align: center;
        justify-content: center;
        white-space: normal;
      }
    }
  }

  // ---------- PAGE WRAPPER ----------

  .homepage {
    @media (max-width: $breakpoint-sm) {
      padding-inline: 16px;
    }
  }
</style>

<BaseComponent theme="theme-brown">
  <main class="homepage">
    <Button href="https://www.reemify.dev" label="Well howdy!" />
    <ContactCallout
      heading="Have a partnership idea, want to contribute, or interested in learning more about how to get involved?"
      body="Reach out and let us know what you're interested in."
    />;
  </main>
</BaseComponent>
