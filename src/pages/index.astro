---
import "../components/globalStyles.astro";
import BaseComponent from "../layouts/BaseComponent.astro";
import Nav from "../layouts/Nav.astro";
---

<style lang="scss">
  body {
    // background: pink;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 900px;
    justify-content: center;
    margin: 0 auto;
    p {
      text-align: left;
    }
  }

  .homepage {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: "League Spartan", sans-serif;
    font-optical-sizing: auto;
    font-style: normal;
    margin: 0 50px;
    // text-align: center;

    .hero {      
      // text-align: center;
      h1 {
        text-align: center;
      }

      p {
        font-size: var(--font-body-lg);
        text-align: center;
      }
    }

    .what-we-do {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;

      .what-we-do-header {
        display: flex;
        flex-direction: column;
      }

      .info-box-wrapper {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;

        .info-box {
          display: flex;
          flex-wrap: wrap;
          width: 350px;
          flex-direction: row;
          background-color: var(--subtle-grey);
          margin: 10px;
          padding: 15px;
        }
      }
    }
  }
</style>

<BaseComponent>
  <Nav />
  <div class="homepage">
    <section class="hero">
      <h1>Language is a right, not a privilege</h1>
      <p>
        Creating safer, affirming, and culturally grounded language services for
        LGBTQIA+ forcibly displaced peoople
      </p>
    </section>

    <section class="our-mission">
      <h3>Our Mission</h3>
      <p>
        The Language Justice Network (LJN) is a community-led not-for-profit
        dedicated to ensuring language is never a barrier to safety, care, or
        belonging. We provide affirming and culturally competent interpreting,
        translation, training, and advocacy for LGBTQIA+ forcibly displaced
        people and those who support them.
      </p>

      <p>
        Our work centres language justice — the belief that everyone has the
        right to communicate in the language they know best, and to be heard,
        respected, and understood.
      </p>

      <a href="" class="cta-button">Learn more about us</a>
    </section>

    <section class="what-we-do">
      <div class="what-we-do-header">
        <h2>What We Do</h2>
        <h3>We build bridges through language</h3>
      </div>

      <ul class="info-box-wrapper">
        <li class="info-box">
          <h4>Interpreting & Translation</h4>
          <p>
            Safe, affirming language services delivered by NAATI-certified
            practitioners
          </p>
        </li>

        <li class="info-box">
          <h4>Training & Workshops</h4>
          <p>
            For service providers and interpreters on trauma-informed,
            queer-affirming practices
          </p>
        </li>
        <li class="info-box">
          <h4>Consulting & Policy Development</h4>
          <p>
            Co-designing frameworks that center LGBTQIA+ multilingual
            communities
          </p>
        </li>
        <li class="info-box">
          <h4>Capacity Building</h4>
          <p>
            supporting bilingual LGBTQIA+ forcibly displaced people to become
            NAATI-certified interpreters
          </p>
        </li>
      </ul>

      <a href="">Explore our services</a>
    </section>

    <section class="community-impact">
      <div class="impact-info-wrapper">
        <h2>Community Impact</h2>
        <p>Building connection, one conversation at a time.</p>
        <p>
          Every word interpreted safely can mean access to housing, healthcare,
          justice, or belonging. Or work supports queer refugees and people
          seeking asylum to express themselves freely and access the support
          they deserve.
        </p>
      </div>

      <div class="impact-supporting-wrapper">
        <div>
          <blockquote cite="https://www.huxley.net/bnw/four.html">
            <p>
              Lorem ipsum dolor sit amet consectetur, adipisicing elit. Quos
              ipsum ab excepturi illum autem reiciendis modi, eaque provident
              commodi perferendis.
            </p>
          </blockquote>
          <p>—Aldous Huxley, <cite>Brave New World</cite></p>
        </div>

        <a href="">Read our impact report</a>
      </div>
    </section>

    <section class="matters">
      <h2>Why Language Justice Matters</h2>
      <p>When language is safe, <em>everything changes.</em></p>

      <p>
        For LGBTQIA+ forcibly displaces people, language is more than
        communication—it's survival, identity, and healing. Yet, too often,
        unsafe interpreting practices lead to harm, misgendering, or cultural
        erasure.
      </p>

      <p>
        LJN is working to transform how interpreting and translation are
        understood—not as neutral transactions, but as relational, ethical, and
        community-driven acts of solidarity.
      </p>

      <a href="">Learn about Language Justice</a>
    </section>

    <section class="get-involved">
      <p>Join us in building a world where everyone is heard.</p>
      <p>
        Your support helps us train interpreters, develop inclusive language
        frameworks, and provide accessible, affirming services for LGBTQIA+
        refugees and migrants.
      </p>

      <p>
        Every contribution makes a difference—in someone's voice, safety, and
        future.
      </p>

      <a href="">Donate Now</a><a href="">Partner with unsafe</a><a href=""
        >Join the Lived Experience Advisory Group</a
      >
    </section>

    <p>
      Want to get in touch? E-mail us at <a href="mailto:admin@ljn.org.au"
        >admin@ljn.org.au</a
      >
    </p>

    <p>
      For now, keep up with us on Instagram at <a
        href="https://www.instagram.com/languagejusticenetwork/"
        target="_blank"
        rel="noreferrer noopener">@languagejusticenetwork</a
      >
    </p>
  </div>
</BaseComponent>
