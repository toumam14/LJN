---
import "../components/globalStyles.astro";
import BaseComponent from "../layouts/BaseComponent.astro";
import Nav from "../layouts/Nav.astro";
---

<style lang="scss">
  body {
    background: pink;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 1120px;
    justify-content: center;
    margin: 0 auto;    
  }

  .coming-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: "League Spartan", sans-serif;
    font-optical-sizing: auto;
    font-style: normal;
    height: 100vh;
    margin: 0 50px;
    text-align: center;

    h1 {
      font-weight: 700;
      font-size: 48px;
      text-align: center;
    }

    h2 {
      font-weight: 400;
    }
  }
</style>

<BaseComponent>
  <Nav />
  <div class="coming-soon">
    <section class="title-page">

      <h1>Language Justice Network</h1>
      <h2>Language is a right, not a privilege</h2>
      <p>
        Creating safer, affirming, and culturally grounded language services for
        lGBTQIA+ forcibly displaced peoople
      </p>
    </section>

    <section class="our-mission">

      <h2>Our Mission</h2>
      <p>
        The Language Justice Network (LJN) is a community-led not-for-profit
        dedicated to ensuring language is never a barrier to safety, care, or
        belonging. We provide affirming and culturally competent interpreting,
        translation, training, and advocacy for LGBTQIA+ forcibly displaced people
        and those who support them. 
      </p>
      
      <p>
        Our work centres language justice — the belief
        that everyone has the right to communicate in the language they know best,
        and to be heard, respected, and understood.
      </p>
      
      <a href="" class="cta-button">Learn more about us</a>
    </section>

    <section class="what-we-do">
      <h2>What We Do</h2>
      <h3>We build bridges through language</h3>

      <div class="info-box">

        <h4>Interpreting & Translation</h4>
        <p>Safe, affirming language services delivered by NAATI-certified practitioners</p>
      </div>

      <div class="info-box">
        <h4>Training & Workshops</h4>
        <p>For service providers and interpreters on trauma-informed, queer-affirming practices</p>
      </div>
      <div class="info-box">
        <h4>Consulting & Policy Development</h4>
        <p>Co-designing frameworks that center LGBTQIA+ multilingual communities</p>
      </div>
      <div class="info-box">
        <h4>Capacity Building</h4>
        <p>supporting bilingual LGBTQIA+ forcibly displaced people to become NAATI-certified interpreters</p>
      </div>


    </section>



    <p>
      Want to get in touch? E-mail us at <a href="mailto:admin@ljn.org.au"
        >admin@ljn.org.au</a
      >
    </p>

    <p>
      For now, keep up with us on Instagram at <a
        href="https://www.instagram.com/languagejusticenetwork/"
        target="_blank"
        rel="noreferrer noopener">@languagejusticenetwork</a
      >
    </p>
  </div>
</BaseComponent>
