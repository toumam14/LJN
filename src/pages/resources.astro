---
import BaseComponent from "../layouts/BaseComponent.astro";
import Button from "../components/Button.astro";
import ContactCallout from "../components/ContactCallout.astro";
import ContentCallout from "../components/ContentCallout.astro";
---

<style lang="scss">
  @use "../styles/variables" as *;

  .featured-resource-card {
    background-color: var(--primary-color);
    border-radius: 30px;
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    max-width: var(--max-width-content);
    margin: 0 auto;
    color: var(--color-white);

    :global(.button--primary:focus-visible) {
      outline-color: var(--color-white);
    }
  }

  .featured-resource-eyebrow,
  .featured-resource-heading,
  .featured-resource-body {
    color: var(--color-white);
    margin: 0;
  }

  .featured-resource-action {
    align-self: flex-start;
    margin-top: var(--spacing-sm);
  }

  @media (max-width: $breakpoint-md) {
    .featured-resource-card {
      padding: var(--spacing-lg);
    }
  }
</style>

<BaseComponent theme="theme-purple">
  <main class="resources-page">
    <section class="content-section">
      <h2 class="eyebrow-text sidebar-entry" id="resources">Resources</h2>
      <p class="heading-text">
        Tools, knowledge, and resources for language justice in action
      </p>
      <p class="intro-text">
        Practical guides, reflections, reports, and community-informed materials
        to support safer multilingual practice across sectors.
      </p>
    </section>
    <hr />
    <section class="content-section">
      <h2 class="eyebrow-text sidebar-entry" id="resource-hub">Resource hub</h2>
      <p class="heading-text">A resource hub grounded in practice</p>
      <p class="intro-text">
        Some resources are practical and immediate while others are reflective
        or strategic, such as articles, reports, practice frameworks, and
        publications that help name the deeper issues shaping language work.
      </p>
      <p class="body-text">
        Across all of them, the aim is the same: to support communication that
        is safer, clearer, and more grounded in the realities of the communities
        most affected by language barriers.
      </p>
    </section>
    <hr />
    <section class="content-section">
      <div class="featured-resource-card">
        <p class="eyebrow-text featured-resource-eyebrow">Featured resource</p>
        <p class="intro-text featured-resource-heading">
          Towards Language Justice: Queering Solidarities Between Interpreters,
          Service Providers, and Community Members
        </p>
        <p class="body-text featured-resource-body">
          This paper sits at the heart of our work at the Language Justice
          Network. It brings together lived experience, practice-based insight,
          and critical reflection to explore how language operates within
          systems that support, and at times fail, LGBTQIA+ forcibly displaced
          people.
        </p>
        <div class="featured-resource-action">
          <Button href="#" label="Download the paper" variant="primary" />
        </div>
      </div>
    </section>
    <hr />
    <section class="content-section">
      <h2 class="eyebrow-text sidebar-entry" id="practitioner-resources">
        Practitioner resources
      </h2>
      <p class="heading-text">For Interpreters & Translators</p>
      <p class="intro-text">
        Language practitioners often work in complex, high-stakes settings where
        communication carries cultural, emotional, and ethical weight. These
        resources are designed to support reflective, accountable, and
        community-informed practice.
      </p>
    </section>
    <hr />
    <section class="content-section">
      <h2 class="eyebrow-text sidebar-entry" id="service-provider-resources">
        Service provider resources
      </h2>
      <p class="heading-text">For Service Providers & Organisations</p>
      <p class="intro-text">
        These resources support services to move beyond minimum language access
        and toward communication practices that are more thoughtful, more
        relational, and more responsive to the communities they serve.
      </p>
    </section>
    <hr />
    <section class="content-section">
      <h2 class="eyebrow-text sidebar-entry" id="community-resources">
        Community resources
      </h2>
      <p class="heading-text">For Community Members</p>
      <p class="intro-text">
        These resources are designed to support people navigating services
        across languages. They aim to make communication safer and more
        transparent, especially for those who may already feel excluded,
        uncertain, or unheard in institutional settings.
      </p>
    </section>
    <hr />
    <section class="content-section">
      <h2 class="eyebrow-text sidebar-entry" id="contribute-collaborate">
        Contribute / collaborate
      </h2>
      <p class="heading-text">Contribute a resource</p>
      <p class="intro-text">
        We welcome collaboration with practitioners, community organisations,
        researchers, and educators who share our commitment to language justice.
      </p>
      <p class="body-text">
        If you have a resource, training tool, report, or publication that
        aligns with this work, we’d love to hear from you.
      </p>
    </section>
    <hr />
    <ContactCallout />
  </main>
</BaseComponent>
