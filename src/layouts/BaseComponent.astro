---
import Nav from "../components/Nav.astro";
import GlobalStyles from "../components/globalStyles.astro";
import Footer from "../components/Footer.astro";
import blueLogoUrl from '../assets/blue-logo.png?url';
import greenLogoUrl from '../assets/green-logo.png?url';
import purpleLogoUrl from '../assets/purple-logo.png?url';
import redLogoUrl from '../assets/red-logo.png?url';

interface Props {
  theme?: string;
}
const { theme = "theme-brown" } = Astro.props;

const logoMap: Record<string, string> = {
  'theme-blue': blueLogoUrl,
  'theme-green': greenLogoUrl,
  'theme-purple': purpleLogoUrl,
  'theme-red': redLogoUrl,
};

const desktopLogo = logoMap[theme];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <title>Language Justice Network</title>
  </head>
  <body class={theme}>
    <GlobalStyles />
    <Nav logo={desktopLogo} />
    <slot />
    <Footer />
  </body>
</html>
