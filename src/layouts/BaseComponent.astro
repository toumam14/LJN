---
import Nav from "../components/Nav.astro";
import GlobalStyles from "../components/globalStyles.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import brownLogo from '../assets/brown-logo.png';
import blueLogo from '../assets/blue-logo.png';
import greenLogo from '../assets/green-logo.png';
import purpleLogo from '../assets/purple-logo.png';
import redLogo from '../assets/red-logo.png';
import brownSoundwave from '../assets/soundwave-brown.svg';
import blueSoundwave from '../assets/soundwave-blue.svg';
import greenSoundwave from '../assets/soundwave-green.svg';
import purpleSoundwave from '../assets/soundwave-purple.svg';
import redSoundwave from '../assets/soundwave-red.svg';

interface Props {
  theme?: string;
}
const { theme = "theme-brown" } = Astro.props;

const logoMap: Record<string, string> = {
  'theme-brown': brownLogo.src,
  'theme-blue': blueLogo.src,
  'theme-green': greenLogo.src,
  'theme-purple': purpleLogo.src,
  'theme-red': redLogo.src,
};

const desktopLogo = logoMap[theme];

const soundwaveMap: Record<string, string> = {
  'theme-brown': brownSoundwave.src,
  'theme-blue': blueSoundwave.src,
  'theme-green': greenSoundwave.src,
  'theme-purple': purpleSoundwave.src,
  'theme-red': redSoundwave.src,
};

const soundwave = soundwaveMap[theme];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <title>Language Justice Network</title>
  </head>
  <body class={theme}>
    <GlobalStyles />
    <Nav logo={desktopLogo} />
    <div class="page-outer">
      <Sidebar soundwave={soundwave} />
      <div class="page-layout">
        <slot />
      </div>
    </div>
    <Footer logo={desktopLogo} />
  </body>
</html>
